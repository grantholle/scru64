{
    "name": "grantholle/scru64",
    "description": "An implementation for generating SCRU64 ID's",
    "keywords": [
        "grantholle",
        "scru64"
    ],
    "homepage": "https://github.com/grantholle/scru64",
    "license": "MIT",
    "authors": [
        {
            "name": "Grant Holle",
            "email": "hollegrant@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "GrantHolle\\Scru64\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GrantHolle\\Scru64\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
